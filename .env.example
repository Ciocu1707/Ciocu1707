# Claude API key (or run `ant auth login` instead)
ANTHROPIC_API_KEY=
# YouTube Data API v3 key - needed for search, video details, channels, comments
YOUTUBE_API_KEY=
# OAuth client secret JSON (Desktop app) - needed only for upload / metadata updates
YOUTUBE_CLIENT_SECRETS=client_secret.json
# Where the OAuth token is cached after first login
YOUTUBE_TOKEN_FILE=~/.youtube_agent/token.json
